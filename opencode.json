{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 1
  },
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "skills": [
    "~/.agents/skills"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
        },
        "oauth": false,
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    },
    "timeout": {
      "catalog": 30000,
      "execution": 300000,
      "startup": 30000
    }
  },
  "snapshots": true,
  "lsp": {
    "github-actions": {
      "command": [
        "gh-actions-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yml",
        ".yaml"
      ]
    },
    "go": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "markdown": {
      "command": [
        "markdown-oxide"
      ],
      "extensions": [
        ".md",
        ".markdown"
      ]
    },
    "python": {
      "command": [
        "ty",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "sql": {
      "command": [
        "sqls"
      ],
      "extensions": [
        ".sql"
      ]
    },
    "typescript": {
      "command": [
        "vtsls",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    },
    "yaml": {
      "command": [
        "yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    }
  },
  "permissions": [
    {
      "action": "read",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "read",
      "effect": "ask",
      "resource": "*.env"
    },
    {
      "action": "read",
      "effect": "ask",
      "resource": "*.env.*"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*.env.example"
    },
    {
      "action": "glob",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "grep",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "webfetch",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "websearch",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git status *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git diff *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git log *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git show *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git branch *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "git push *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "git reset --hard *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "git clean *"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/Área de trabalho/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/opencode/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.agents/*"
    },
    {
      "action": "external_directory",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "subagent",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "subagent",
      "effect": "allow",
      "resource": "orchestrate"
    },
    {
      "action": "delegation_spec",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "delegation_report",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "delegation_receipt",
      "effect": "allow",
      "resource": "*"
    }
  ]
}
