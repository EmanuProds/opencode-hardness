{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 1
  },
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "skills": [
    "~/.agents/skills"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "oauth": false,
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
    },
    "timeout": {
      "catalog": 30000,
      "execution": 300000,
      "startup": 30000
    }
  },
  "snapshots": true,
  "model": "freellmapi/auto:orchastrate",
  "provider": {
    "freellmapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeLLMAPI",
      "options": {
        "baseURL": "http://127.0.0.1:31415/v1",
        "apiKey": "{file:~/.config/opencode/secrets/freellm.key}"
      },
      "models": {
        "auto": {
          "name": "Auto (router picks the best available model)",
          "limit": {
            "context": 104857,
            "output": 8192
          }
        },
        "fusion": {
          "name": "Fusion (panel of models answer in parallel, a judge synthesizes one answer)",
          "limit": {
            "context": 104857,
            "output": 8192
          }
        },
        "auto:code": {
          "name": "Auto: Code (named fallback chain)",
          "limit": {
            "context": 204800,
            "output": 8192
          }
        },
        "auto:contracts": {
          "name": "Auto: Contracts (named fallback chain)",
          "limit": {
            "context": 209715,
            "output": 8192
          }
        },
        "auto:database": {
          "name": "Auto: Database (named fallback chain)",
          "limit": {
            "context": 800000,
            "output": 8192
          }
        },
        "auto:review": {
          "name": "Auto: Review (named fallback chain)",
          "limit": {
            "context": 838860,
            "output": 8192
          }
        },
        "auto:orchastrate": {
          "name": "Auto: Orchastrate (named fallback chain)",
          "limit": {
            "context": 800000,
            "output": 8192
          }
        }
      }
    }
  },
  "lsp": {
    "github-actions": {
      "command": [
        "gh-actions-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yml",
        ".yaml"
      ]
    },
    "go": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "markdown": {
      "command": [
        "markdown-oxide"
      ],
      "extensions": [
        ".md",
        ".markdown"
      ]
    },
    "python": {
      "command": [
        "ty",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "sql": {
      "command": [
        "sqls"
      ],
      "extensions": [
        ".sql"
      ]
    },
    "typescript": {
      "command": [
        "vtsls",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    },
    "yaml": {
      "command": [
        "yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    }
  },
  "permissions": [
    {
      "action": "read",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "read",
      "effect": "ask",
      "resource": "*.env"
    },
    {
      "action": "read",
      "effect": "ask",
      "resource": "*.env.*"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*.env.example"
    },
    {
      "action": "glob",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "grep",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "webfetch",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "websearch",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git status *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git diff *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git log *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git show *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git branch *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "git push *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "git reset --hard *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "git clean *"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/Área de trabalho/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/opencode/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.agents/*"
    },
    {
      "action": "external_directory",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "subagent",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "subagent",
      "effect": "allow",
      "resource": "orchestrate"
    },
    {
      "action": "delegation_spec",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "delegation_report",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "delegation_receipt",
      "effect": "allow",
      "resource": "*"
    }
  ]
}
